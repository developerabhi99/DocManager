{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",

    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",

    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src", "generated"],
  "exclude": ["node_modules", "prisma", "dist"]
}