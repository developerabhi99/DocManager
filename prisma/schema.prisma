// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  salt       String  
  imageUrl   String?
  empId      String?
  isActive   Boolean  @default(true)

  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])

  userTypeId String
  userType   UserType @relation(fields: [userTypeId], references: [id])

  appointments Appointment[]
  schedules   DoctorSchedule[]
  employeeSchedules EmployeeSchedule[]
  medicalReports MedicalReport[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UserType {
  id        String   @id @default(cuid())
  name      String   @unique
  parentId  String?

  parent    UserType?  @relation("UserTypeHierarchy", fields: [parentId], references: [id])
  children  UserType[] @relation("UserTypeHierarchy")

  users     User[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  users       User[]
  permissions RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?

  roles       RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())

  roleId       String
  role         Role   @relation(fields: [roleId], references: [id])

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model Patient {
  id         String   @id @default(cuid())
  name       String
  email      String?  @unique
  phone      String?
  address    String?
  age        Int?
  gender     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  appointments Appointment[]
  transactions Transaction[]
}

model Appointment {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String
  doctor       User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  dateTime     DateTime
  notes        String?
  status       String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, REFERRED
  visitNumber  Int      @default(1) // 1st visit, 2nd visit, etc.
  referredTo   String?  // Department or doctor ID for referral
  referredFrom String?  // Previous appointment ID if this is a referral
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions Transaction[]
  reports       MedicalReport[]
}

model Transaction {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  
  amount        Float
  paymentMethod String   // CASH, CARD, ONLINE, INSURANCE
  status        String   @default("PENDING") // PENDING, PAID, REFUNDED
  description   String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MedicalReport {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  doctorId      String
  doctor        User     @relation(fields: [doctorId], references: [id])
  
  diagnosis     String?
  symptoms      String?
  treatment     String?
  prescription  String?
  notes         String?
  reportUrl     String?  // File URL for uploaded reports
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmployeeSchedule {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  dayOfWeek  Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime  String   // Format: "09:00"
  endTime    String   // Format: "17:00"
  isAvailable Boolean @default(true)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, dayOfWeek, startTime])
}

model DoctorSchedule {
  id         String   @id @default(cuid())
  doctorId   String
  doctor     User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  dayOfWeek  Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime  String   // Format: "09:00"
  endTime    String   // Format: "17:00"
  isAvailable Boolean @default(true)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([doctorId, dayOfWeek, startTime])
}
